{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "maicli",
  "version": "0.1.0",
  "identifier": "com.modeluxai.maicli",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "maicli — ModeluXAI",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#0E1014"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png"
    ],
    "publisher": "ModeluXAI",
    "copyright": "Copyright © 2026 ModeluXAI"
  }
}