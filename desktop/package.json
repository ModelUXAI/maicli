{
  "name": "maicli-desktop",
  "version": "0.4.1",
  "private": true,
  "description": "Host Electron untuk frontend maicli (React + TypeScript)",
  "homepage": "https://github.com/ModelUXAI/maicli",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.modeluxai.maicli",
    "productName": "maicli",
    "files": [
      "main.js",
      "preload.js",
      "bin/**/*",
      "frontend-dist/**/*"
    ],
    "extraResources": [],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "msi"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": {
    "name": "ModeluXAI",
    "email": "support@modeluxai.com"
  }
}
